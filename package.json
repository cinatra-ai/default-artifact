{
  "name": "@cinatra-ai/default-artifact",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "artifact",
    "dependencies": [],
    "artifact": {
      "accepts": {
        "file": {
          "mimeTypes": [
            "*/*"
          ]
        },
        "connectorRef": {
          "resolvedMimeTypes": [
            "*/*"
          ]
        },
        "dashboard": true
      }
    }
  }
}
